NEON_RUNTIME_DATABASE_URL=jdbc:postgresql://replace-with-neon-pooled-host/neondb?sslmode=require
NEON_RUNTIME_DATABASE_USERNAME=moneysnap_app
NEON_RUNTIME_DATABASE_PASSWORD=replace-with-runtime-password

NEON_MIGRATION_DATABASE_URL=jdbc:postgresql://replace-with-neon-direct-host/neondb?sslmode=require
NEON_MIGRATION_DATABASE_USERNAME=replace-with-owner-role
NEON_MIGRATION_DATABASE_PASSWORD=replace-with-owner-password

APPLE_AUTH_ENABLED=false
APPLE_CLIENT_ID=com.ansandy.moneysnap
APPLE_TEAM_ID=replace-with-apple-team-id
APPLE_KEY_ID=replace-with-sign-in-with-apple-key-id
APPLE_PRIVATE_KEY_P8=replace-with-p8-pem-using-literal-backslash-n
APPLE_REFRESH_TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
